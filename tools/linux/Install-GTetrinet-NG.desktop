#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Install GTetrinet NG — TetriNET
Name[de]=GTetrinet NG — TetriNET installieren
Comment=Install local and online falling-block battles on Steam Deck or Linux
Comment[de]=Installiert Blockduelle für Steam Deck oder Linux, lokal und online
Exec=sh -c "f=\\$(mktemp) || exit 1; trap 'rm -f \\"\\$f\\"' EXIT; curl -fsSL --max-time 60 https://github.com/jarvis-jhk/gtetrinet-ng/releases/download/@TAG@/install.sh -o \\"\\$f\\" && grep -q 'END OF GTETRINET INSTALLER' \\"\\$f\\" && bash \\"\\$f\\" || { m='Downloading or running the installer failed. Please try again. / Der Installer konnte nicht geladen oder gestartet werden. Bitte erneut versuchen.'; zenity --error --text=\\"\\$m\\" || kdialog --error \\"\\$m\\"; exit 1; }"
Icon=applications-games
Terminal=true
Categories=Game;
StartupNotify=false
